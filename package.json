{
  "name": "vertical-live",
  "productName": "Vertical Live",
  "version": "1.1.3",
  "description": "Minimal Windows desktop app that captures a camera + microphone, composes a vertical 1080x1920 frame and streams 720x1280 H.264/AAC to Facebook over RTMPS with optional 1080x1920 local recording.",
  "author": {
    "name": "Vertical Live",
    "email": "noreply@example.invalid"
  },
  "license": "MIT",
  "private": true,
  "main": "out/main/main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:synthetic": "cross-env VERTICAL_LIVE_SYNTHETIC_INPUT=true electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css,html,yml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css,html,yml,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir tests/integration",
    "setup:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "generate:icon": "node scripts/generate-icon.mjs",
    "generate:installer": "node scripts/generate-installer-assets.mjs",
    "package:win": "npm run generate:installer && npm run build && electron-builder --win --dir",
    "dist:win": "npm run generate:installer && npm run build && electron-builder --win",
    "release:win": "npm run generate:installer && npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
